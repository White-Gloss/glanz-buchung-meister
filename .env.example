# Template only. Keep actual values in the protected hosting environment.
# Existing application services; configure only the integrations in use.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
OWNER_EMAIL=
# Optional stable auth user ID for manual booking confirmation.
OWNER_USER_ID=
RESEND_API_KEY=
MAIL_FROM=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
QONTO_SECRET_KEY=
QONTO_IBAN=

# Meta WhatsApp Cloud API. Empty/disabled provider means no automated sends.
# Set WHATSAPP_PROVIDER to meta only with the complete configuration below.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Supported Graph API version from your Meta app, in vNN.N format.
WHATSAPP_API_VERSION=
# Existing approved template with two positional body text parameters.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# International owner number. ADMIN_WHATSAPP_NUMBER takes precedence.
ADMIN_WHATSAPP_NUMBER=
OWNER_WHATSAPP=
# Optional, 1000-30000 ms. Default: 10000 ms.
WHATSAPP_TIMEOUT_MS=
# Existing authenticated automation scheduler secret.
REMINDER_CRON_SECRET=

# RO App booking push (optional; see docs/ops-roapp-env.md)
ROAPP_API_KEY=
ROAPP_BRANCH_ID=
ROAPP_ASSIGNEE_ID=
ROAPP_ORDER_TYPE_ID=
# ROAPP_API_BASE=https://api.roapp.io/v2
# ROAPP_ENTITY_MAP={"premium":102,"felgen":201}

# Lexware Office Public API (optional; see docs/ops-lexware-env.md)
# Key from Lexware Office → Add-ons → Public API. Never commit or paste in chat.
LEXWARE_API_KEY=
# LEXWARE_API_BASE=https://api.lexware.io/v1

# Zoho CRM + Books (EU). Leave empty until OAuth is issued in the Zoho API console.
# ZOHO_OPS_ENABLED=true only after CRM Deals/Events and Books taxes (19 %) are verified.
ZOHO_DC=eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=
ZOHO_WEBHOOK_SECRET=
# ZOHO_OPS_ENABLED=false

# Bitrix24 / VibeCode. Website-Buchungen (#buchung) werden als CRM-Deals angelegt.
# Persönlicher Schlüssel, niemals committen. Siehe docs/ops-bitrix-env.md
VIBE_API_KEY=
# VIBE_API_BASE=https://vibecode.bitrix24.com/v1
# VIBE_PRODUCT_MAP={"basis":2,"premium":4,"keramik":6}


