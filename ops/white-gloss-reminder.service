# Minuetlicher Aufruf des lokalen Automations-Endpunkts durch den Timer.
# Der eigenstaendige Node-Runner wird separat vom .output-Release installiert.
# Das Bearer-Token bleibt in der Umgebung; weder Shell noch Prozessargumente
# oder Journal-Ausgaben enthalten den Wert.

[Unit]
Description=White Gloss notification and reminder run
After=network-online.target white-gloss.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
# systemd liest diese Datei vor dem Wechsel zu deploy; 0600 root:root bleibt richtig.
EnvironmentFile=/etc/white-gloss/environment
TimeoutStartSec=70
ExecStart=/usr/bin/node /usr/local/lib/white-gloss/run-notifications.mjs

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
