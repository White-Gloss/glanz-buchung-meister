[Unit]
Description=White Gloss web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/white-gloss-current
EnvironmentFile=/etc/white-gloss/environment
ExecStart=/usr/bin/node /srv/white-gloss-current/.output/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/white-gloss-current
MemoryMax=4G

[Install]
WantedBy=multi-user.target
