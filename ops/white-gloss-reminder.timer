# Minuetlicher Anstoss fuer Ausgang und faellige Terminerinnerungen.
#
# Erinnerungen werden pro bestaetigter Terminversion dedupliziert. Der Worker
# beansprucht Nachrichten atomar und versendet mit begrenzten Wiederholungen.

[Unit]
Description=White Gloss notification and reminder worker

[Timer]
OnCalendar=*-*-* *:*:00
# Holt einen Lauf nach, der waehrend eines Neustarts ausgefallen ist.
Persistent=true
# Wenige Sekunden Versatz verteilen die Last und vermeiden, dass mehrere
# Zeitgeber gleichzeitig anlaufen.
RandomizedDelaySec=5
AccuracySec=1s
Unit=white-gloss-reminder.service

[Install]
WantedBy=timers.target
